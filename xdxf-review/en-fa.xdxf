<!-- Pragmatic XDXF sample for manual review: TEI sense -> def, cit trans -> dtrn, cit example -> ex/ex_orig/ex_tran, usg -> categ, gramGrp -> pos/gr, note -> c, xr/def -> dtrn, ref -> kref/iref. -->
<xdxf lang_from="ENG" lang_to="PER" format="visual">
